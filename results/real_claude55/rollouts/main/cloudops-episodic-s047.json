 "final": {
  "reply_raw": "The recurring pattern is consistent: availability restores during active incidents, scope confirmed, tier 1, short TTLs. A standing rule covering exactly that envelope would remove the per-case overhead without widening access beyond what's already being granted.\n\n{\"mode\": \"precedent\", \"rule\": {\"action\": \"attach_role\", \"resource\": \"*\", \"conditions\": {\"incident_active\": [\"eq\", \"1\"], \"scope_match\": [\"eq\", \"1\"], \"role_tier\": [\"le\", \"1\"], \"ttl_min\": [\"le\", \"30\"], \"purpose\": [\"eq\", \"availability\"]}}}",
  "mode": "precedent",
  "rule": {
   "action": "attach_role",
   "resource": "*",
   "conditions": {
    "incident_active": [
     "eq",
     "1"
    ],
    "scope_match": [
     "eq",
     "1"
    ],
    "role_tier": [
     "le",
     "1"
    ],
    "ttl_min": [
     "le",
     "30"
    ],
    "purpose": [
     "eq",
     "availability"
    ]
   }
  },
  "tool_call": null
 },
