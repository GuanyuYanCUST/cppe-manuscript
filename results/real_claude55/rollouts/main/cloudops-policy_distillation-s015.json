 "final": {
  "reply_raw": "I'll propose a standing rule rather than continue case-by-case, since the pattern is uniform and tightly bounded. But I'm keeping it narrow — tier 1 only, availability purpose only, short TTL, and only when an active incident with confirmed scope is present. If any of those is missing, it falls back to case adjudication.\n\n{\"mode\": \"precedent\", \"rule\": {\"action\": \"attach_role\", \"resource\": \"*\", \"conditions\": {\"role_tier\": [\"eq\", \"1\"], \"purpose\": [\"eq\", \"availability\"], \"ttl_min\": [\"le\", \"30\"], \"incident_active\": [\"eq\", \"1\"], \"scope_match\": [\"eq\", \"1\"]}}}\n\nOne caveat I want on record: this rule trusts the `incident_active` and `scope_match` attributes as enforced by the authorization layer. If those are merely caller-asserted strings rather than independently validated, the rule should not be adopted, since it would let a caller self-certify the very conditions that justify the grant.",
  "mode": "precedent",
  "rule": {
   "action": "attach_role",
   "resource": "*",
   "conditions": {
    "role_tier": [
     "eq",
     "1"
    ],
    "purpose": [
     "eq",
     "availability"
    ],
    "ttl_min": [
     "le",
     "30"
    ],
    "incident_active": [
     "eq",
     "1"
    ],
    "scope_match": [
     "eq",
     "1"
    ]
   }
  },
  "tool_call": null
 },
